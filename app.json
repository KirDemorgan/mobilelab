{
  "expo": {
    "name": "mobile-labs",
    "slug": "mobile-labs",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "scheme": "mobilelabs",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Местоположение нужно для отображения на карте и уведомлений рядом с сохранёнными метками."
        }
      ],
      "expo-notifications"
    ],
    "ios": {}
  }
}
